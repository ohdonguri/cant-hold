{
  "name": "cant-hold",
  "private": true,
  "description": "이번 웨이브는 못 막습니다 — 성급 합성 타워디펜스",
  "scripts": {
    "test": "node tools/test.js && node tools/seedcheck.js",
    "seedcheck": "node tools/seedcheck.js",
    "tune": "node tools/tune.js",
    "curve": "node tools/curve.js",
    "affinity": "node tools/affinity.js",
    "sim": "node tools/tune.js one",
    "shot": "node tools/shot.js",
    "parity": "node tools/parity.js",
    "sprites": "node tools/sprites.js",
    "build": "node build.mjs",
    "verify:build": "node tools/verify-build.mjs",
    "android:sync": "node build.mjs && cap sync android && node tools/android-sync.mjs",
    "android:apk": "npm run android:sync && node tools/android-build.mjs",
    "deploy": "node build.mjs && npx --yes wrangler@4 deploy"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0"
  }
}
