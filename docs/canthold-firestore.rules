// Fragment: insert inside match /databases/{database}/documents.
// Never replace the shared project's full rules with this file.
match /games/canthold/saves/{uid} {
  function ownsSave() {
    return request.auth != null && request.auth.uid == uid;
  }
  function validCantholdSave() {
    let d = request.resource.data;
    return d.keys().hasOnly(['v', 'unlocked', 'best', 'cleared', 'run', 'updatedAt'])
      && d.v is int && d.v >= 3
      && d.unlocked is int && d.unlocked >= 1 && d.unlocked <= 64
      && d.best is list && d.best.size() <= 64
      && d.cleared is list && d.cleared.size() <= 64
      && (d.run == null || (d.run is map && d.run.size() <= 12));
  }
  allow read: if ownsSave();
  allow create: if ownsSave() && validCantholdSave();
  allow update: if ownsSave() && validCantholdSave()
    && request.resource.data.unlocked >= resource.data.unlocked;
  allow delete: if false;
}
